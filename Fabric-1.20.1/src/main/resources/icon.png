<svg width="512" height="512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- 从左上角到右下角的蓝色渐变 -->
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a8a" />   <!-- 左上：亮深蓝 -->
      <stop offset="100%" stop-color="#0f172a" /> <!-- 右下：暗夜蓝 -->
    </linearGradient>
    <!-- 字母阴影 -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#000" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- 圆角矩形背景（圆角半径 64px，适配 512 尺寸） -->
  <rect width="512" height="512" rx="80" ry="80" fill="url(#bgGradient)" />

  <!-- 居中大写字母 B，字号 280，白色，加阴影 -->
  <text x="256" y="260"
        font-family="Arial, Helvetica, sans-serif"
        font-size="280"
        font-weight="bold"
        fill="#ffffff"
        text-anchor="middle"
        dominant-baseline="central"
        filter="url(#shadow)">B</text>
</svg>